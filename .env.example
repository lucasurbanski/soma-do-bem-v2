# =====================================================================
# .env.example — copie para .env.local e preencha com valores REAIS.
# NUNCA versione .env.local (está no .gitignore).
# Segredos (service role, senha do banco, secrets) só existem no servidor.
# =====================================================================

# ---- Supabase (público: pode ir ao browser) ----
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ... (anon key)

# ---- Supabase (SEGREDO — só server-side; NUNCA no browser) ----
SUPABASE_SERVICE_ROLE_KEY=eyJ... (service role key)

# ---- Conexão direta ao Postgres (migrations/seeds) ----
DATABASE_URL=postgresql://postgres:SENHA@db.SEU-PROJETO.supabase.co:5432/postgres

# ---- App ----
APP_BASE_URL=http://localhost:3000
NODE_ENV=development

# ---- Feature flags (mantenha false nesta fase) ----
PAYMENTS_ENABLED=false
WOOVI_ENABLED=false
WOOVI_SPLIT_ENABLED=false
WOOVI_SUBACCOUNTS_ENABLED=false
WITHDRAWALS_ENABLED=false
KYC_ENABLED=false

# ---- Woovi/OpenPix (desativado; preencher só no sandbox no futuro) ----
# sandbox: https://api.woovi-sandbox.com  |  produção: https://api.openpix.com.br
WOOVI_API_BASE_URL=https://api.woovi-sandbox.com
WOOVI_APP_ID=
WOOVI_WEBHOOK_HMAC_SECRET=
WOOVI_WEBHOOK_PUBLIC_KEY=

# ---- Provider mock (dev): segredo p/ assinar o webhook mock ----
MOCK_WEBHOOK_SECRET=troque-por-um-segredo-aleatorio

# ---- Observabilidade (opcional) ----
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
